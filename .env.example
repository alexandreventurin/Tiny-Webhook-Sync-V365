# Copy this file to .env for local development and fill in the secret values.
# Never commit the populated .env file.

# Database
DATABASE_URL=
DB_POOL_MAX_SIZE=3
DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=20
RUN_DB_SCHEMA_ON_STARTUP=0

# Public application URL
APP_BASE_URL=

# Tiny/Olist OAuth and API
TINY_API_BASE=https://api.tiny.com.br/public-api/v3
TINY_AUTH_BASE=https://accounts.tiny.com.br
TINY_A_CLIENT_ID=
TINY_A_CLIENT_SECRET=
TINY_C_CLIENT_ID=
TINY_C_CLIENT_SECRET=
TINY_A_TOKEN=
TINY_C_TOKEN=

# Administrative access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE=28800

# Replication controls
ENABLE_FETCH_A=true
EXECUTE_TINY_C=false
ALLOW_VENDA_IDS=
FETCH_CACHE_MINUTES=10
JOB_DELAY_MINUTES=0
MAX_ORDERS_TO_REPLICATE=0
TINY_WRITE_LIMIT_10MIN=600

# Worker
WORKER_ENABLED=1
WORKER_POLL_SECONDS=30
WORKER_BATCH_SIZE=3
WORKER_HEARTBEAT_SECONDS=120
WORKER_STALE_LOCK_RESET_SECONDS=300
PROACTIVE_TOKEN_REFRESH_ENABLED=0

# Dashboard and tracking
ORIGIN_PANEL_CACHE_SECONDS=10
REJUDERME_TRACKING_PAGE=https://rejuderme.com.br/pages/rastreio
